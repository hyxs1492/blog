---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/`, label: '首页' },
  { href: `${base}/about/`, label: '关于' },
];

const current = Astro.url.pathname;
const isActive = (href) =>
  href === `${base}/` ? current === `${base}/` || current === base : current.startsWith(href);
---

<header class="site-header">
  <nav class="container nav">
    <a class="brand" href={`${base}/`}>我的博客</a>
    <ul class="nav-links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
