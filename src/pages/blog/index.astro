---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import BlogCard from '../../components/BlogCard.astro';
import { groupPostsByCategory } from '../../utils/categories';

const allBlogPosts = await getCollection('blog');
// 按分类分组，组内按发布日期倒序（分组逻辑见 src/utils/categories.ts）
const categories = groupPostsByCategory(allBlogPosts);
const totalPosts = allBlogPosts.length;
---

<BaseLayout
  title="文章 — HYXS 的博客"
  description="关于开发、技术学习与心得的文章"
>
  <Navigation />

  <main class="blog-page">
    <div class="container">
      <header class="blog-header">
        <h1 class="page-title">文章</h1>
        <p class="page-subtitle">
          记录技术学习、开发实践与日常思考
        </p>
        <p class="page-meta">共 {categories.length} 个分类 · {totalPosts} 篇</p>
      </header>

      <div class="category-sections">
        {categories.map((category) => (
          <section class="category-section" id={category.slug}>
            <div class="category-head">
              <h2 class="category-name">{category.name}</h2>
              <span class="category-count">{category.count} 篇</span>
            </div>

            <div class="blog-grid">
              {category.posts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={post.id}
                  tags={post.data.tags}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    max-width: 500px;
    margin: 0 auto;
  }

  .page-meta {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-dim);
    opacity: 0.8;
  }

  /* ---- 分类分组 ---- */
  .category-sections {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .category-section {
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .category-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .category-count {
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .blog-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }

    .category-sections {
      gap: 2.5rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
