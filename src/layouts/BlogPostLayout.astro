---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category?: string | undefined;
  updatedDate?: Date | undefined;
  tags?: string[] | undefined;
  headings?: MarkdownHeading[] | undefined;
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, category, updatedDate, tags, headings } = Astro.props;
// 只收录「最外层」章节：取文章里出现的最小标题层级（有的文章用 #，多数用 ##）
const bodyHeadings = headings ?? [];
const topDepth = bodyHeadings.length > 0
  ? Math.min(...bodyHeadings.map((h) => h.depth))
  : 2;
const tocHeadings = bodyHeadings.filter((h) => h.depth === topDepth);

const formattedPubDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — HYXS 的博客`} description={description}>
  <Navigation />

  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <a href={`${base}blog/`} class="back-link">← 返回文章</a>
        <h1 class="post-title shimmer-text">{title}</h1>
        {/* 分类没有独立页面，这里只标明归属；按分类的完整列表见 /blog/blog/ */}
        {category && (
          <span class="post-category">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
            {category}
          </span>
        )}
        <div class="post-meta">
          <time class="post-date">{formattedPubDate}</time>
          {formattedUpdatedDate && (
            <span class="post-updated">更新于 {formattedUpdatedDate}</span>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-body">
        {tocHeadings.length > 1 && (
          <details class="toc-mobile">
            <summary>目录（{tocHeadings.length} 章）</summary>
            <ul>
              {tocHeadings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <div class="post-content">
          <slot />
        </div>

        {tocHeadings.length > 1 && (
          <>
            <nav class="toc" aria-label="文章目录">
              <p class="toc-title">目录</p>
              <ul>
                {tocHeadings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </>
        )}
      </div>
    </div>
  </article>
  <script>
    const toc = document.querySelector('.toc');
    const tocMobile = document.querySelector('.toc-mobile');
    if (tocMobile) {
      tocMobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => tocMobile.removeAttribute('open'));
      });
    }
    if (toc) {
      const links = Array.from(toc.querySelectorAll('a'));
      const map = new Map();
      links.forEach((a) => {
        const href = a.getAttribute('href') || '';
        const id = decodeURIComponent(href.replace(/^#/, ''));
        const el = document.getElementById(id);
        if (el) map.set(el, a);
      });

      if (map.size > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const active = map.get(entry.target);
              if (!active) return;
              links.forEach((l) => l.classList.remove('active'));
              active.classList.add('active');
            });
          },
          { rootMargin: '-100px 0px -70% 0px', threshold: 0 }
        );
        map.forEach((_, el) => observer.observe(el));
      }
    }
  </script>
</BaseLayout>

<style>
  .blog-post {
    min-height: 100vh;
    padding: 8rem 2rem 5rem;
  }

  .container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 3rem;
    animation: fadeInDown 1s ease-out;
  }

  .back-link {
    display: inline-block;
    color: var(--color-accent-purple);
    text-decoration: none;
    margin-bottom: 2rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    transform: translateX(-5px);
    color: var(--color-accent-pink);
  }

  .post-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  /* 纯展示的分类徽章（分类没有独立页面，所以不是链接） */
  .post-category {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    margin-bottom: 1rem;
    border-radius: 999px;
    color: var(--color-accent-purple);
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .post-date {
    color: var(--color-accent-purple);
    font-weight: 500;
  }

  .post-updated {
    color: var(--color-text-dim);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-accent-purple);
  }

  .post-content {
    background: var(--color-bg-card);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 1rem;
    padding: 3rem;
    animation: fadeInUp 1s ease-out 0.2s backwards;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    scroll-margin-top: 110px;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    grid-template-areas: "content toc";
    gap: 2.5rem;
    align-items: start;
  }

  .post-content {
    grid-area: content;
    min-width: 0;
  }

  .toc {
    grid-area: toc;
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
    padding: 1rem 1.1rem;
    background: var(--color-bg-card);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.45;
    animation: fadeInUp 1s ease-out 0.3s backwards;
  }

  .toc-title {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    text-transform: uppercase;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li {
    margin: 0.2rem 0;
  }

  .toc a {
    display: block;
    word-break: break-word;
    padding: 0.2rem 0 0.2rem 0.6rem;
    border-left: 2px solid transparent;
    color: var(--color-text-dim);
    text-decoration: none;
    line-height: 1.4;
    transition: all 0.2s ease;
  }

  .toc a:hover,
  .toc a.active {
    color: var(--color-accent-purple);
    border-left-color: var(--color-accent-purple);
  }

  .toc-mobile {
    display: none;
  }

  @media (max-width: 1100px) {
    .post-body {
      display: block; /* 单列：让目录条的 sticky 以整个内容区为参照 */
    }

    /* 手机上侧边目录隐藏，改用顶部可折叠的“目录”条 */
    .toc {
      display: none;
    }

    .toc-mobile {
      display: block;
      grid-area: toc;
      position: sticky;
      top: calc(var(--nav-height) + 0.5rem);
      z-index: 40;
      background: var(--color-bg-card);
      border: 1px solid rgba(168, 85, 247, 0.25);
      border-radius: 0.75rem;
      font-size: 0.85rem;
      max-height: 55vh;
      overflow-y: auto;
      margin-bottom: 1.25rem;
    }

    .toc-mobile summary {
      cursor: pointer;
      padding: 0.75rem 1rem;
      color: var(--color-text);
      font-weight: 600;
      list-style: none;
    }

    .toc-mobile summary::-webkit-details-marker {
      display: none;
    }

    .toc-mobile summary::after {
      content: '▾';
      float: right;
      color: var(--color-text-dim);
      transition: transform 0.2s ease;
    }

    .toc-mobile[open] summary::after {
      transform: rotate(180deg);
    }

    .toc-mobile ul {
      list-style: none;
      margin: 0;
      padding: 0 1rem 0.75rem;
    }

    .toc-mobile a {
      display: block;
      padding: 0.3rem 0;
      color: var(--color-text-dim);
      text-decoration: none;
      line-height: 1.4;
    }

    .toc-mobile a:active,
    .toc-mobile a:hover {
      color: var(--color-accent-purple);
    }
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: 6.5rem 1rem 3rem;
    }

    .post-content {
      padding: 1.5rem 1.25rem;
      border-radius: 0.75rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }

    .post-content :global(h3) {
      font-size: 1.2rem;
    }
  }

  /* 防止长代码 / 长单词 / 表格把页面撑宽 */
  .post-content :global(p),
  .post-content :global(li),
  .post-content :global(td),
  .post-content :global(th) {
    overflow-wrap: break-word;
  }

  .post-content :global(code) {
    overflow-wrap: anywhere;
  }

  .post-content :global(pre) {
    max-width: 100%;
  }

  .post-content :global(table) {
    max-width: 100%;
  }

  .post-content :global(h2) {
    font-size: 2rem;
    background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(p) {
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-text-dim);
  }

  .post-content :global(a) {
    color: var(--color-accent-purple);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-purple);
    transition: all 0.3s ease;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-pink);
    border-color: var(--color-accent-pink);
  }

  .post-content :global(code) {
    background: rgba(168, 85, 247, 0.1);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: var(--color-accent-purple);
  }

  .post-content :global(pre) {
    background: var(--color-bg-darker);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 0.5rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--color-text);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 2rem;
    color: var(--color-text-dim);
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-accent-purple);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-dim);
  }

  /* ---------- 表格 ---------- */
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .post-content :global(thead th) {
    background: rgba(139, 92, 246, 0.2);
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
  }

  .post-content :global(tbody tr:nth-child(even)) {
    background: rgba(148, 163, 184, 0.06);
  }

  .post-content :global(tbody tr:hover) {
    background: rgba(59, 130, 246, 0.08);
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .post-content {
      padding: 2rem 1.5rem;
    }
  }
</style>
