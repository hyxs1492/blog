---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/ParticleField.astro';
import { getCollection } from 'astro:content';
import '../styles/hero.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout pageTitle="首页">
  <section class="hero-full">
    <ParticleField />
    <div class="hero-inner">
      <p class="hero-kicker">// HELLO, WORLD</p>
      <h1>你好，我是 <span class="accent">博主</span></h1>
      <p class="hero-sub">记录我的学习笔记、技术心得，以及随手写下的想法。</p>
      <div class="hero-actions">
        <a class="button" href="#posts">阅读文章 →</a>
        <a class="button ghost" href={`${base}/about/`}>关于我</a>
      </div>
    </div>
    <a class="scroll-hint" href="#posts" aria-label="向下滚动查看文章">↓</a>
  </section>

  <section class="post-list" id="posts">
    <h2>全部文章</h2>
    <ul>
      {
        posts.map((post) => (
          <li class="post-list-item">
            <a href={`${base}/${post.id}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
