---
import type { CategoryGroup } from '../../../utils/categories';
import { getAllCategories } from '../../../utils/categories';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import BlogCard from '../../../components/BlogCard.astro';
import CategoryChips from '../../../components/CategoryChips.astro';

const base = import.meta.env.BASE_URL;
const categories = await getAllCategories();
const totalPosts = categories.reduce((sum, category) => sum + category.count, 0);
---

<BaseLayout
  title="分类 — HYXS 的博客"
  description="按分类浏览本站全部文章"
>
  <Navigation />

  <main class="category-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">分类</h1>
        <p class="page-subtitle">
          共 {categories.length} 个分类、{totalPosts} 篇文章
        </p>
      </header>

      <CategoryChips categories={categories} showAll={false} />

      <div class="category-list">
        {categories.map((category: CategoryGroup) => (
          <section class="category-block">
            <div class="category-head">
              <h2 class="category-name">
                <a href={`${base}blog/category/${category.slug}/`}>{category.name}</a>
              </h2>
              <span class="category-count">{category.count} 篇</span>
            </div>

            {category.description && (
              <p class="category-description">{category.description}</p>
            )}

            <div class="posts-grid">
              {category.posts.map((post) => (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={post.id}
                  category={post.data.category}
                  tags={post.data.tags}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .category-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .category-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .category-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .category-name a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .category-name a:hover {
    color: var(--color-accent-purple);
  }

  .category-count {
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .category-description {
    color: var(--color-text-dim);
    line-height: 1.7;
    margin: -0.75rem 0 1.5rem;
    max-width: 70ch;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .category-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
